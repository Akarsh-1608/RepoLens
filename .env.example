# RepoLens Environment Variables

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/repolens

# Redis (optional for local dev - set USE_QUEUE_FALLBACK=true if Redis unavailable)
REDIS_URL=redis://localhost:6379
USE_QUEUE_FALLBACK=true

# GitHub API (Optional: increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# LLM Provider (OpenAI or any OpenAI-compatible API)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Embedding Provider (OpenAI or any OpenAI-compatible API)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Server & Client Config
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Processing Safeguards & Limits
MAX_FILES_PER_REPO=500
MAX_FILE_SIZE_BYTES=102400
MAX_REPO_SIZE_BYTES=52428800
GITHUB_CONCURRENCY=5
