# RepoLens Server Environment Variables

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/repolens

# Redis (optional for local dev - set USE_QUEUE_FALLBACK=true if Redis unavailable)
REDIS_URL=redis://localhost:6379
USE_QUEUE_FALLBACK=false

# GitHub API
GITHUB_TOKEN=ghp_your_token_here

# LLM Provider (OpenAI-compatible)
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Embedding Provider (OpenAI-compatible)
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Processing Limits
MAX_FILES_PER_REPO=500
MAX_FILE_SIZE_BYTES=102400
MAX_REPO_SIZE_BYTES=52428800
GITHUB_CONCURRENCY=5
